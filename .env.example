# Ejemplo sin credenciales reales. La API incluye catálogo, autenticación,
# administración, órdenes y caja/efectivo; completar únicamente lo que se usará.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Límite de lectura pública por IP/minuto, memoria local. No sustituye bloqueo de login.
CATALOG_RATE_LIMIT=120

# Generar con npm run auth:setup en .env local. No usar JWT_SECRET antiguo.
# Sin claves válidas, auth no se habilita (503); nunca hay clave de respaldo.
AUTH_JWT_SECRET=
AUTH_CSRF_SECRET=
AUTH_ISSUER=cafeteria-api
AUTH_AUDIENCE=cafeteria-web
AUTH_IP_LIMIT=20

# Opcional: sin estas claves las rutas de imagen devuelven 503; resto de API funciona.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Requerida para cobrar a invitados y reimprimir su QR de registro. Generar una
# clave exclusiva de 32 bytes en hexadecimal (64 caracteres); no reutilizar las
# claves de auth ni compartirla. Sin clave, el cobro de invitados devuelve 503
# sin crear pago/venta; los cobros asociados a cliente siguen disponibles.
TICKET_ENCRYPTION_KEY=
# Etiqueta no secreta de 1–32 caracteres para identificar la clave vigente.
TICKET_KEY_VERSION=v1

# Ajustar según el ADR de acceso a PostgreSQL; no usar estos valores en producción.
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/cafeteria
# Base vacía exclusiva para migraciones; nunca la base principal.
SHADOW_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/cafeteria_shadow
# Base aislada obligatoria para npm run test:integration; el runner crea y elimina
# bases temporales propias a partir de esta conexión.
# TEST_DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@localhost:5432/cafeteria_test
# Alternativa Docker: npm run db:up genera .env.docker sin modificar este archivo.

# Solo pruebas durante el desarrollo. No insertar claves reales aquí.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Correo y sesiones se añadirán al definir sus mecanismos.
