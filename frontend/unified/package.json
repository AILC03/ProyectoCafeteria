{
  "name": "cafeteria-unified-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit --passWithNoTests",
    "test:components": "vitest run --project components",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --pass-with-no-tests",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "electron:dev": "electron .",
    "dist:win": "electron-builder --win portable nsis --x64"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxlint": "^1.81.0",
    "playwright": "^1.65.1",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.1.1"
  },
  "build": {
    "appId": "com.cafeteria.terminal",
    "productName": "Cafetería Terminal",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!electron/**/*.unit.test.ts",
      "!node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] },
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "identity": null
    }
  }
}
